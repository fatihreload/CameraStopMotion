    <style name="Theme.StopMotion" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#FFB020</item>
        <item name="colorPrimaryDark">#090C12</item>
        <item name="colorAccent">#FFB020</item>
        <item name="android:windowBackground">#FF090C12</item>
        <item name="alertDialogTheme">@style/Theme.StopMotion.Dialog</item>
